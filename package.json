{
  "name": "rsfiler",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src && cd src-tauri && cargo clippy",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" && cd src-tauri && cargo fmt",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run && cd src-tauri && cargo test",
    "test:watch": "vitest",
    "coverage:fe": "vitest run --coverage",
    "coverage:be": "cd src-tauri && cargo tarpaulin --skip-clean --out Html",
    "coverage:be:clean": "cd src-tauri && cargo tarpaulin --out Html",
    "coverage": "npm run coverage:fe && npm run coverage:be",
    "coverage:clean": "npm run coverage:fe && npm run coverage:be:clean",
    "doc:fe": "typedoc --entryPointStrategy expand ./src --out docs/fe",
    "doc:fe:open": "typedoc --entryPointStrategy expand ./src --out docs/fe && npx serve docs/fe",
    "doc:be": "cd src-tauri && CARGO_TARGET_DIR=target/doc_build cargo doc --no-deps",
    "doc:be:open": "cd src-tauri && CARGO_TARGET_DIR=target/doc_build cargo doc --no-deps --open",
    "doc": "npm run doc:fe && npm run doc:be",
    "doc:open": "npm run doc:fe:open && npm run doc:be:open",
    "check": "npm run format:check && npm run lint && npm run test && cd src-tauri && cargo fmt --check"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "loglevel": "^1.9.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
