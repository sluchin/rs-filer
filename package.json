{
  "name": "rsfiler",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "bindings:generate": "cd src-tauri && UPDATE_BINDINGS=1 cargo test --lib tests::test_specta_builder_bindings_up_to_date",
    "prelint": "vite build",
    "lint": "eslint src tests",
    "lint:rust": "cd src-tauri && cargo clippy",
    "lint:all": "npm run lint && npm run lint:rust",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.{ts,tsx}\" && cd src-tauri && cargo fmt",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.{ts,tsx}\" && cd src-tauri && cargo fmt --check",
    "pretest": "vite build",
    "test": "vitest run",
    "test:rust": "cd src-tauri && cargo test",
    "test:all": "npm run test && npm run test:rust",
    "test:watch": "vitest",
    "coverage:fe": "vitest run --coverage",
    "coverage:be": "cd src-tauri && cargo tarpaulin --skip-clean --engine llvm --fail-under 100 --out Html",
    "coverage:be:clean": "cd src-tauri && cargo tarpaulin --out Html",
    "coverage": "npm run coverage:fe && npm run coverage:be",
    "coverage:clean": "npm run coverage:fe && npm run coverage:be:clean",
    "doc:fe": "typedoc --entryPointStrategy expand ./src --out docs/fe",
    "doc:fe:open": "typedoc --entryPointStrategy expand ./src --out docs/fe && npx serve docs/fe",
    "doc:be": "cd src-tauri && CARGO_TARGET_DIR=target/doc_build cargo doc --no-deps",
    "doc:be:open": "cd src-tauri && CARGO_TARGET_DIR=target/doc_build cargo doc --no-deps --open",
    "doc": "npm run doc:fe && npm run doc:be",
    "doc:open": "npm run doc:fe:open && npm run doc:be:open",
    "check": "npm run format:check && npm run lint:all && npm run test:all"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "highlight.js": "^11.12.0",
    "loglevel": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
