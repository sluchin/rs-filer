{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-read-directory",
    "allow-dirs-have-entries",
    "allow-get-item-info",
    "allow-dir-stats",
    "allow-get-home-dir",
    "allow-create-directory",
    "allow-create-file",
    "allow-rename-item",
    "allow-extract-archive",
    "allow-quit-app",
    "allow-load-keymap",
    "allow-load-config",
    "allow-save-config",
    "allow-save-last-paths",
    "allow-complete-path",
    "allow-read-preview",
    "allow-run-transfer",
    "allow-cancel-transfer",
    "allow-check-conflicts",
    "allow-check-stale-overwrites",
    "allow-check-nested-conflicts",
    "allow-open-item",
    "allow-open-in-editor",
    "allow-open-terminal",
    "allow-run-external-command",
    "allow-list-drives",
    "allow-get-disk-space",
    "allow-log-frontend-message",
    "allow-copy-files-to-clipboard",
    "allow-read-clipboard-files",
    "allow-copy-text-to-clipboard",
    "allow-load-history",
    "allow-save-history"
  ]
}
